# ==================================================================
#  DSC-HUB SECRETS TEMPLATE  —  copy to secrets.yaml and fill in
#  ------------------------------------------------------------------
#  cp secrets.yaml.template secrets.yaml
#  Then either edit by hand, or run ./generate-secrets.sh (fresh keys).
#
#  ⚠  NEVER commit secrets.yaml. Never paste it into a chat, an issue,
#     or a support thread.
# ==================================================================

# ---- WiFi --------------------------------------------------------
wifi_ssid: "CHANGEME_YOUR_SSID"
wifi_password: "CHANGEME_YOUR_WIFI_PASSWORD"

# ---- Kit SoftAP setup (standalone unboxing — dsc-*-kit.yaml) ------
# Printed on the kit card. Shared by HUB SoftAP + Control/pots joining it.
dsc_setup_ap_password: "CHANGEME_SETUP_AP"

# ---- Hub ---------------------------------------------------------
dsc_hub_api_key: "CHANGEME_BASE64_32_BYTES"
dsc_hub_ota_password: "CHANGEME_HEX_16"
dsc_hub_ap_password: "CHANGEME_AP"

# ---- Soil nodes --------------------------------------------------
dsc_pot1_api_key: "CHANGEME_BASE64_32_BYTES"
dsc_pot1_ota_password: "CHANGEME_HEX_16"
dsc_pot1_ap_password: "CHANGEME_AP"

dsc_pot2_api_key: "CHANGEME_BASE64_32_BYTES"
dsc_pot2_ota_password: "CHANGEME_HEX_16"
dsc_pot2_ap_password: "CHANGEME_AP"

dsc_pot3_api_key: "CHANGEME_BASE64_32_BYTES"
dsc_pot3_ota_password: "CHANGEME_HEX_16"
dsc_pot3_ap_password: "CHANGEME_AP"

dsc_pot4_api_key: "CHANGEME_BASE64_32_BYTES"
dsc_pot4_ota_password: "CHANGEME_HEX_16"
dsc_pot4_ap_password: "CHANGEME_AP"

# ---- Appliance nodes (mains-switching) ---------------------------
dsc_heater_api_key: "CHANGEME_BASE64_32_BYTES"
dsc_heater_ota_password: "CHANGEME_HEX_16"
dsc_heater_ap_password: "CHANGEME_AP"

dsc_heatmat_api_key: "CHANGEME_BASE64_32_BYTES"
dsc_heatmat_ota_password: "CHANGEME_HEX_16"
dsc_heatmat_ap_password: "CHANGEME_AP"

dsc_humidifier_api_key: "CHANGEME_BASE64_32_BYTES"
dsc_humidifier_ota_password: "CHANGEME_HEX_16"
dsc_humidifier_ap_password: "CHANGEME_AP"

dsc_dehumidifier_api_key: "CHANGEME_BASE64_32_BYTES"
dsc_dehumidifier_ota_password: "CHANGEME_HEX_16"
dsc_dehumidifier_ap_password: "CHANGEME_AP"

# ---- DSC-CONTROL (CYD panel) -------------------------------------
# dsc_cyd1_* and dsc_control_* are aliases for the same panel keys.
dsc_cyd1_api_key: "CHANGEME_BASE64_32_BYTES"
dsc_cyd1_ota_password: "CHANGEME_HEX_16"
dsc_cyd1_ap_password: "CHANGEME_AP"
dsc_control_api_key: "CHANGEME_BASE64_32_BYTES"
dsc_control_ota_password: "CHANGEME_HEX_16"
dsc_control_ap_password: "CHANGEME_AP"

# ---- ESP-NOW shared key (hub + all four pots) --------------------
# 16 bytes / 32 hex chars. Same value on every peer.
espnow_key: "CHANGEME_HEX_16"
