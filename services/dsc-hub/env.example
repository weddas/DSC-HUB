# DSC-HUB 7.0.0 Pi appliance — copy to .env (never commit .env)
DSC_DATA=/var/lib/dsc-hub
DSC_AP_SSID=DSC-Brain
DSC_AP_PSK=Digital1
DSC_AP_CHANNEL=6

# Brain
DSC_BRAIN_API_KEY=
DSC_EXPECTED_FIRMWARE=7.0.0.0
DSC_SURFACE_VERSION=7.3.0

# Integrations (house LAN via eth0 uplink)
OLLAMA_BASE_URL=http://192.168.86.2:11434
OLLAMA_MODEL=llama3.1:8b
CANNALIB_API_URL=http://192.168.86.2:8790
CANNALIB_API_KEY=
CANNALIB_USE_LOCAL_FALLBACK=true

# SkyConnect — set after plug-in: ls -l /dev/serial/by-id/
ZIGBEE_DEVICE=/dev/serial/by-id/usb-Nabu_Casa_SkyConnect_10C4DA8170ED-if00

# ESPHome device API keys (Noise) — rotate on cutover
DSC_HUB_API_KEY=
DSC_CONTROL_API_KEY=
DSC_POT1_API_KEY=
DSC_POT2_API_KEY=
DSC_POT3_API_KEY=
DSC_POT4_API_KEY=
DSC_HEATER_API_KEY=
DSC_HEATMAT_API_KEY=
DSC_HUMIDIFIER_API_KEY=
DSC_DEHUMIDIFIER_API_KEY=
