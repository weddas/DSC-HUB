[Unit]
Description=DSC-HUB Wi-Fi AP (DSC-Brain)
After=network-pre.target
Before=dsc-hub-compose.service
Wants=network-pre.target

[Service]
Type=simple
Restart=always
RestartSec=5
ExecStartPre=/bin/sh -c 'killall wpa_supplicant 2>/dev/null; true'
ExecStart=/etc/dsc-hub/ap-run.sh
ExecStop=/bin/sh -c 'kill $(cat /run/dsc-hub-dnsmasq.pid 2>/dev/null) 2>/dev/null; killall hostapd dnsmasq 2>/dev/null; true'
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
