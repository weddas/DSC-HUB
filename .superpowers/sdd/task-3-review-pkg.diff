diff --git a/homeassistant/custom_components/dsc_hub/frontend/src/lib/lightViewModel.ts b/homeassistant/custom_components/dsc_hub/frontend/src/lib/lightViewModel.ts
new file mode 100644
index 0000000..e4a6143
