@echo off
cd /d "y:\Digital Stealth Care\Projects\DSC-HUB"
:loop
timeout /t 45 /nobreak >nul
REM If merge_staging or exclusive driver running, keep waiting
tasklist /FI "IMAGENAME eq python.exe" /FO CSV | findstr /I "_n087_exclusive_merge.py merge_staging_to_master" >nul
if %ERRORLEVEL%==0 goto loop
REM Driver dead ? if no summary yet, resume
if exist "brain\data\_n087_exclusive_merge_summary.json" goto end
echo %DATE% %TIME% watchdog launching resume>> "brain\data\_n087_exclusive_merge.log"
"C:\Program Files\Python314\python.exe" -u "brain\data\_n087_exclusive_merge_resume.py" >> "brain\data\_n087_exclusive_merge_stdout.txt" 2>> "brain\data\_n087_exclusive_merge_stderr.txt"
:end
