# ==================================================================
#  DSC-HUB — .gitignore
#  The first line is the most important one in this repo.
# ==================================================================
secrets.yaml
**/secrets.yaml
secrets.yaml.*
!secrets.yaml.template
*.old-*

# ESPHome build artefacts
.esphome/
**/.esphome/
*.bin
*.elf
firmware/v4/verify_v4
firmware/v4/verify_v4.exe
**/__pycache__/
*.py[cod]
brain/data/*.sqlite3
brain/data/*.sqlite3-*
brain/data/staging/*.sqlite3
brain/data/staging/*.sqlite3-*
brain/data/**/*.sqlite3
brain/data/**/*.sqlite3-*
# Named pre-* snapshots (do not match *.sqlite3 because suffix follows .sqlite3.)
brain/data/dsc_brain.sqlite3.pre_*

# Never commit a live HA config
home-assistant_v2.db*
.storage/

# Generated catalog dumps (curated YAML and source inventories stay tracked)
homeassistant/data/dsc_strains_*.json
homeassistant/data/dsc_lab_*.json
homeassistant/data/dsc_*_merged.json
homeassistant/data/dsc_nutrients_*.json
homeassistant/data/dsc_mediums_*.json
homeassistant/data/dsc_lights_*.json
homeassistant/data/dsc_strain_catalog_want_bands.json
homeassistant/data/dsc_bank_discovery.json
homeassistant/data/*.checkpoint.json
homeassistant/data/media/
homeassistant/data/exports/
!homeassistant/data/dsc_*_catalog.yaml
!homeassistant/data/dsc_*_pack_*.yaml
!homeassistant/data/STRAIN_SOURCES.md
!homeassistant/data/LIGHT_SOURCES.md
!homeassistant/data/dsc_light_pack_photometrics.yaml

# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Cursor local (keep rules if added later under .cursor/rules)
.cursor/

# Superseded tree — canonical firmware is firmware/v4/
firmware/DSC-HUB v4/**
!firmware/DSC-HUB v4/MOVED.md

# Private business / marketing / build docs — keep local only, never push
Media_and_Docs/

# Local durable scrape backups (not for git)
_BACKUP_N087_*/
brain/data/*.pre_ce_copyback_*
brain/data/_n087_exclusive_merge*.log
brain/data/_n087_exclusive_merge_results.jsonl


# Fat lab caches (NAS backup only; GitHub 100MB limit)
brain/data/staging/_cache_cannlytics/
