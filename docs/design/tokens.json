{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$comment": "DSC design tokens — draft 2026-09-06. See tokens.md for full context. `status` marks whether a token is live in dsc.css or proposed for Phase 5 landing.",
  "meta": {
    "version": "0.1.0-draft",
    "date": "2026-09-06",
    "source_of_truth": "frontend/src/styles/dsc.css :root, :host, .dsc-root",
    "themes": ["operator", "public", "light-mode (exploration)"],
    "cascade_selectors": [":root", ":host", ".dsc-root"]
  },

  "color": {
    "surface": {
      "--dsc-black":        { "value": "#0b0e14",                     "role": "app background",              "status": "live" },
      "--dsc-black-2":      { "value": "#12171f",                     "role": "raised panel, popover",       "status": "live" },
      "--dsc-gray-1":       { "value": "#12171f",                     "role": "alias of black-2",            "status": "live" },
      "--dsc-gray-2":       { "value": "#1a2230",                     "role": "input / button fill",         "status": "live" },
      "--dsc-gray-3":       { "value": "#243044",                     "role": "border / divider / rule",     "status": "live" },
      "--dsc-gray-4":       { "value": "#8b95a8",                     "role": "alias of gray-5",             "status": "dead" },
      "--dsc-gray-5":       { "value": "#8b95a8",                     "role": "muted text, label",           "status": "live" },
      "--dsc-muted":        { "value": "#8b95a8",                     "role": "alias of gray-5 for prose",   "status": "live" },
      "--dsc-white":        { "value": "#e8eef8",                     "role": "primary text",                "status": "live" },
      "--dsc-glass":        { "value": "rgba(18, 23, 31, 0.78)",      "role": "glass card fill",             "status": "live" },
      "--dsc-glass-border": { "value": "rgba(36, 48, 68, 0.55)",      "role": "glass card border",           "status": "live" }
    },
    "accent": {
      "--dsc-teal":         { "value": "#26c6da",                     "role": "grow accent, links, focus",   "status": "live" },
      "--dsc-teal-dim":     { "value": "rgba(38, 198, 218, 0.45)",    "role": "teal border, subtle accent",  "status": "live" },
      "--dsc-teal-glow":    { "value": "rgba(38, 198, 218, 0.55)",    "role": "teal glow",                   "status": "live" },
      "--dsc-blue":         { "value": "#4f9dff",                     "role": "live accent",                 "status": "live" },
      "--dsc-blue-dim":     { "value": "rgba(79, 157, 255, 0.4)",     "role": "blue border, glow",           "status": "live" },
      "--dsc-purple":       { "value": "#a78bfa",                     "role": "fleet accent",                "status": "live" },
      "--dsc-purple-dim":   { "value": "rgba(167, 139, 250, 0.35)",   "role": "purple border",               "status": "live" },
      "--dsc-neon":         { "value": "#66bb6a",                     "role": "tone ok, CTA fill",           "status": "live" },
      "--dsc-neon-dim":     { "value": "rgba(102, 187, 106, 0.32)",   "role": "neon border",                 "status": "live" },
      "--dsc-neon-glow":    { "value": "rgba(0, 230, 118, 0.4)",      "role": "neon glow",                   "status": "dead" },
      "--dsc-amber":        { "value": "#ffb74d",                     "role": "tone warn",                   "status": "live" },
      "--dsc-amber-dim":    { "value": "rgba(255, 183, 77, 0.45)",    "role": "amber border, banner glow",   "status": "proposed" },
      "--dsc-orange":       { "value": "#ff8a65",                     "role": "warm accent (airflow)",       "status": "live" },
      "--dsc-bad":          { "value": "#ef5350",                     "role": "tone bad, offline, failed",   "status": "live" },
      "--dsc-bad-dim":      { "value": "rgba(239, 83, 80, 0.4)",      "role": "bad border, subtle alert",    "status": "proposed" },
      "--dsc-bad-soft":     { "value": "#ef5350",                     "role": "alias of bad",                "status": "dead" }
    },
    "domain_soil": {
      "--dsc-soil-1":       { "value": "#5b9f6b",                     "role": "root viz — living medium",    "status": "live" },
      "--dsc-soil-2":       { "value": "#4a8f9f",                     "role": "root viz — moisture",         "status": "live" },
      "--dsc-soil-3":       { "value": "#c4a35a",                     "role": "root viz — dry medium",       "status": "live" },
      "--dsc-soil-4":       { "value": "#8d6e63",                     "role": "root viz — coco / substrate", "status": "live" }
    },
    "domain_vessel": {
      "--dsc-vessel-fabric":     { "value": "rgba(180, 210, 190, 0.85)", "role": "fabric pot silhouette",  "status": "proposed" },
      "--dsc-vessel-plastic":    { "value": "rgba(160, 190, 170, 0.9)",  "role": "plastic pot silhouette", "status": "proposed" },
      "--dsc-vessel-water":      { "value": "rgba(120, 210, 230, 0.95)", "role": "water level fill",       "status": "proposed" },
      "--dsc-vessel-teal-fill":  { "value": "rgba(38, 198, 218, 0.22)",  "role": "tank teal fill",         "status": "proposed" },
      "--dsc-vessel-teal-hint":  { "value": "rgba(38, 198, 218, 0.12)",  "role": "kit pulse teal",         "status": "proposed" }
    },
    "semantic": {
      "--dsc-brand-ink":  { "value": "var(--dsc-white)",     "role": "wordmark text, primary display", "status": "proposed" },
      "--dsc-brand-mark": { "value": "var(--dsc-teal)",      "role": "mark stroke, brand hairline",    "status": "proposed" },
      "--dsc-link":       { "value": "var(--dsc-teal)",      "role": "links",                          "status": "proposed" },
      "--dsc-focus-ring": { "value": "var(--dsc-teal-glow)", "role": "focus outline glow",             "status": "proposed" }
    }
  },

  "typography": {
    "family": {
      "--dsc-font":         { "value": "'Segoe UI', 'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif", "role": "body / UI",                        "status": "live" },
      "--dsc-mono":         { "value": "'Cascadia Code', 'IBM Plex Mono', ui-monospace, monospace",        "role": "code, SURFACE stamp",              "status": "live" },
      "--dsc-font-display": { "value": "'IBM Plex Sans', ui-sans-serif, system-ui, sans-serif",             "role": "public hero / section headline",   "status": "proposed" }
    },
    "scale": {
      "--dsc-fs-xs": { "value": "11px", "role": "tiny helper",           "status": "live" },
      "--dsc-fs-sm": { "value": "12px", "role": "small text",            "status": "live" },
      "--dsc-fs-md": { "value": "13px", "role": "label, secondary body", "status": "live" },
      "--dsc-fs-lg": { "value": "14px", "role": "body base, card head",  "status": "live" },
      "--dsc-fs-h3": { "value": "20px", "role": "public card head",      "status": "proposed" },
      "--dsc-fs-h2": { "value": "30px", "role": "public section head",   "status": "proposed" },
      "--dsc-fs-h1": { "value": "44px", "role": "public hero head",      "status": "proposed" }
    }
  },

  "radius": {
    "--dsc-radius":      { "value": "10px",   "role": "card, input, button",   "status": "live" },
    "--dsc-radius-lg":   { "value": "14px",   "role": "large glass panel",     "status": "live" },
    "--dsc-radius-full": { "value": "9999px", "role": "chip, pill",            "status": "proposed" }
  },

  "shadow": {
    "--dsc-shadow":       { "value": "0 8px 24px rgba(0, 0, 0, 0.45)", "role": "elevated drop",   "status": "live" },
    "--dsc-shadow-tight": { "value": "0 2px 8px rgba(0, 0, 0, 0.55)",  "role": "subtle elevation","status": "live" }
  },

  "space": {
    "--dsc-space-1": { "value": "4px",  "role": "micro-gap",                  "status": "proposed" },
    "--dsc-space-2": { "value": "8px",  "role": "standard gap",               "status": "proposed" },
    "--dsc-space-3": { "value": "12px", "role": "card inner, banner gap",     "status": "proposed" },
    "--dsc-space-4": { "value": "16px", "role": "section gap, card outer",    "status": "proposed" },
    "--dsc-space-5": { "value": "24px", "role": "row separator",              "status": "proposed" },
    "--dsc-space-6": { "value": "40px", "role": "public section rhythm",      "status": "proposed" }
  },

  "motion": {
    "--dsc-ease":         { "value": "cubic-bezier(0.22, 1, 0.36, 1)",   "role": "placement / entrance settle", "status": "live" },
    "--dsc-ease-in-out":  { "value": "cubic-bezier(0.65, 0, 0.35, 1)",   "role": "standard in-out",             "status": "dead" },
    "--dsc-ease-spring":  { "value": "cubic-bezier(0.34, 1.4, 0.64, 1)", "role": "press / release",             "status": "live" },
    "--dsc-dur-1":        { "value": "120ms",                            "role": "fast",                        "status": "live" },
    "--dsc-dur-2":        { "value": "220ms",                            "role": "medium",                      "status": "live" },
    "--dsc-dur-3":        { "value": "360ms",                            "role": "slow (drawer, chart morph)",  "status": "live" },
    "--dsc-stagger-step": { "value": "34ms",                             "role": "stagger step",                "status": "live" }
  },

  "star_field_dsc_root_scoped": {
    "--dsc-stars-far":   { "value": "color-mix(in srgb, var(--dsc-white) 38%, transparent)", "role": "distant star layer", "status": "live" },
    "--dsc-stars-mid":   { "value": "color-mix(in srgb, var(--dsc-teal) 42%, transparent)",  "role": "mid star layer",     "status": "live" },
    "--dsc-stars-near":  { "value": "color-mix(in srgb, var(--dsc-white) 62%, transparent)", "role": "near star layer",    "status": "live" },
    "--dsc-stars-speed": { "value": "0.4",                                                    "role": "parallax base speed","status": "live" }
  },

  "rejected_undefined_fallbacks": {
    "$comment": "These names are referenced in components as var() fallbacks but never declared. They are bugs — fix the call site, do not declare the token.",
    "--dsc-danger":               { "found_in": "pages/SetupPage.tsx",   "fix": "rename to --dsc-bad" },
    "--dsc-green":                { "found_in": "viz/charts.tsx",        "fix": "use --dsc-neon" },
    "--dsc-green-dim":            { "found_in": "viz/charts.tsx",        "fix": "use --dsc-neon-dim" },
    "--dsc-border":               { "found_in": "component style",       "fix": "use --dsc-gray-3" },
    "--dsc-muted-fg":             { "found_in": "component style",       "fix": "use --dsc-gray-5" },
    "--dsc-surface":              { "found_in": "component style",       "fix": "use --dsc-black-2" },
    "--dsc-text":                 { "found_in": "component style",       "fix": "use --dsc-white" },
    "--dsc-journal-row-height":   { "found_in": "journal browser",       "fix": "declare (40px) or delete usage" },
    "--dsc-journal-visible-rows": { "found_in": "journal browser",       "fix": "declare (3) or delete usage" }
  }
}
